<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">
    <persistence-unit name="practicaJPA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.demo.entidades.Paciente</class>
        <class>com.demo.entidades.Medico</class>
        <class>com.demo.entidades.Consulta</class>
        <class>com.demo.entidades.HistorialClinico</class>
        <class>com.demo.entidades.Medicamento</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:practicadb"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
